{
  "name": "pos",
  "version": "0.1.0",
  "description": "POS (Point of Sale) is a desktop application developed by MrPythonist (Muhammad Aqib) for Restaurants",
  "author": "Muhammad Aqib",
  "private": true,
  "main": "start.js",
  "type": "module",
  "scripts": {
    "electron": "cross-env NODE_ENV=dev nodemon --exec \"electron .\"",
    "electron-build": "electron-builder",
    "package-win": "electron-packager . POS --no-win32metadata --overwrite --no-asar --platform=win32 --arch=x64 --prune=true --out=release-builds"
  },
  "dependencies": {
    "async": "^3.2.6",
    "better-sqlite3": "^12.4.1",
    "body-parser": "^2.2.0",
    "btoa": "^1.2.1",
    "electron-context-menu": "^4.1.1",
    "electron-store": "^11.0.0",
    "electron-winstaller": "^5.4.0",
    "express": "^5.1.0",
    "express-fileupload": "^1.5.2",
    "html2canvas": "^1.4.1",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "is-port-reachable": "^4.0.0",
    "jquery": "^3.7.1",
    "jsbarcode": "^3.12.1",
    "jspdf": "^3.0.3",
    "macaddress": "^0.5.3",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "nedb": "^1.8.0",
    "path": "^0.12.7",
    "print-js": "^1.6.0",
    "socket.io": "^4.8.1",
    "sweetalert2": "^11.23.0",
    "xmlhttprequest": "^1.8.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9",
    "nodemon": "^3.1.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.mrpythonist.pos",
    "productName": "POS System",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "**/*",
      "assets/**/*",
      "db/**/*",
      "public/**/*",
      "!dist",
      "!release-builds",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets",
        "filter": ["**/*"]
      },
      {
        "from": "public/",
        "to": "public",
        "filter": ["**/*"]
      },
      {
        "from": "db/",
        "to": "db",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "assets/images/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] },
        { "target": "msi", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    }
  }
}
